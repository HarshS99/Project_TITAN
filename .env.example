# ==============================================================================
# PROJECT TITAN - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and populate your respective API keys.
# ==============================================================================

# --- AI Model Providers ---
# Groq API Key (High-speed inference: LLaMA 3.3 70B, etc.)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API Key (Gemini 2.5 Flash / Pro)
GEMINI_API_KEY=your_gemini_api_key_here

# Mistral API Key (Codestral / Mistral Large)
MISTRAL_API_KEY=your_mistral_api_key_here

# --- GitHub Integration (Optional - for Git/VCS automated deployment) ---
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_token_here
GITHUB_USERNAME=your_github_username_here

# --- Runtime Directory Paths ---
TITAN_PROJECTS_DIR=./projects
TITAN_LOGS_DIR=./logs

# --- Engine Defaults ---
DEFAULT_AI_PROVIDER=gemini
DEFAULT_GROQ_MODEL=llama-3.3-70b-versatile
